# ─── Server ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9000
TRUST_PROXY=1
LOG_LEVEL=info

# ─── URLs ────────────────────────────────────────────────────────────
APP_URL=https://quillhive.pages.dev
API_URL=https://quillhive.onrender.com

# ─── Database ────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
# For Neon.tech: postgresql://user:pass@host.neon.tech/quillhive?sslmode=require

# ─── JWT (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_SECRET=replace-with-a-different-long-random-secret

# ─── Redis / Upstash ─────────────────────────────────
# You need TWO connections to the SAME Upstash database.
# They use different protocols for different purposes.

# 1. REST API - used for rate limiting and caching
#    Get from: Upstash Dashboard → your Redis → REST API tab
#    This value starts with: https://
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io

# 2. REST Token - the authentication token for the REST API
#    Get from: same REST API tab, below the URL
#    This is a long random string, NOT a URL
UPSTASH_REDIS_REST_TOKEN=replace-with-your-upstash-rest-token

# 3. BullMQ TCP connection - used for all background jobs
#    Get from: Upstash Dashboard → your Redis → Connect tab
#    → select "ioredis" → copy the full connection string
#    This value starts with: rediss://
#    WITHOUT this, weekly emails, notifications, campaign
#    expiry, and scheduled posts will not work
BULLMQ_REDIS_URL=rediss://default:YOUR_PASSWORD@your-upstash-endpoint.upstash.io:6379

# ─── Email ───────────────────────────────────────────────────────────
# Required for password reset, email verification, weekly reports
# Get API key at: resend.com
RESEND_API_KEY=
EMAIL_PREFERENCE_SECRET=replace-with-a-long-random-secret
MAIL_FROM=no-reply@yourdomain.com
MAIL_DOMAIN=yourdomain.com
DMCA_EMAIL=dmca@yourdomain.com
APPEALS_EMAIL=appeals@yourdomain.com
OWNER_EMAIL=your@email.com

# ─── Cloudinary ──────────────────────────────────────────────────────
# Recommended for durable production media storage. Without Cloudinary,
# production must set UPLOADS_DIR to a persistent mounted volume path.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOADS_DIR=

# ─── Flutterwave Payments ────────────────────────────────────────────
# Both naming conventions supported - fill in one set
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_WEBHOOK_SECRET=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# ─── OAuth ───────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── AI Writing Tools ────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ─── Push Notifications ──────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ─── Bot Protection ──────────────────────────────────────────────────
# Cloudflare Turnstile - free at dash.cloudflare.com → Turnstile
TURNSTILE_SECRET_KEY=

# ─── Admin Tools ─────────────────────────────────────────────────────
# Required for Carousel Generator (admin only tool)
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ─── Error Monitoring ────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.05
